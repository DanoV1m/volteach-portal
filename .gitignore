# Dependency and build folders in subfolder
volteach-app/node_modules/
volteach-app/dist/
volteach-app/.firebase/
volteach-app/coverage/
volteach-app/.env*
!volteach-app/.env.example

# Root exclusions
.DS_Store
*.log
.agents/

# Never commit local administrative secrets or new registry exports
serviceAccountKey.json
**/serviceAccountKey.json
admin_database/*.csv
private_exports/
